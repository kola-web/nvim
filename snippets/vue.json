  "vformmodal-1": {
    "body": [
      "<template>",
      "  <div @click=\"showModal\">",
      "    <slot></slot>",
      "    <a-modal",
      "      title=\"创建批次\"",
      "      width=\"60%\"",
      "      :visible=\"show\"",
      "      okText=\"提交\"",
      "      cancelText=\"关闭\"",
      "      @cancel=\"handleCancel\"",
      "      @ok=\"handleSubmit\"",
      "    >",
      "      <a-form-model :model=\"form\" :label-col=\"labelCol\" :wrapper-col=\"wrapperCol\" :rules=\"rules\">",
      "        <a-form-model-item label=\"创建批次的名称\" prop=\"name\">",
      "          <a-input v-model=\"form.name\" />",
      "        </a-form-model-item>",
      "        <a-form-model-item label=\"输入码的数量\" prop=\"num\">",
      "          <a-input-number v-model=\"form.num\" :max=\"2000\" placeholder=\"最大值2000\" style=\"width: 120px\" />",
      "        </a-form-model-item>",
      "      </a-form-model>",
      "    </a-modal>",
      "  </div>",
      "</template>",
      "",
      "<script>",
      "export default {",
      "  components: {},",
      "  props: {},",
      "  data() {",
      "    return {",
      "      show: false,",
      "      labelCol: { span: 4 },",
      "      wrapperCol: { span: 14 },",
      "      form: {",
      "        name: \"\",",
      "        region: undefined,",
      "        date1: undefined,",
      "        delivery: false,",
      "        type: [],",
      "        resource: \"\",",
      "        desc: \"\",",
      "      },",
      "      rules: {",
      "        name: [{ required: true, message: \"请输入批次名称\", trigger: \"change\" }],",
      "        num: [{ required: true, message: \"请输入批次码的数量\", trigger: \"blur\" }],",
      "      },",
      "    };",
      "  },",
      "  methods: {",
      "    getDetail() {},",
      "    showModal() {",
      "      this.getDetail();",
      "      this.show = true;",
      "    },",
      "    handleSubmit() {",
      "      this.\\$refs.ruleForm.validate((valid) => {",
      "        if (valid) {",
      "          alert(\"submit!\");",
      "        } else {",
      "          console.log(\"error submit!!\");",
      "          return false;",
      "        }",
      "      });",
      "    },",
      "    handleCancel(e) {",
      "      this.show = false;",
      "    },",
      "  },",
      "};",
      "</script>",
      "",
      "<style lang=\"scss\" scoped></style>"
    ],
    "prefix": "vformmodal"
  },
  "vlist-home": {
    "body": [
      "<template>",
      "  <a-spin :spinning=\"spinning\">",
